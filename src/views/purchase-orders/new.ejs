<!DOCTYPE html>
<html lang="pt-BR">
    <%- include("../partials/head", { title }) %>
    <body>
        <%- include("../partials/page-start", { title }) %>
        <div class="page-heading"><div><a class="back-link" href="/purchase-orders">← Pedidos de compra</a><h1>Cadastrar pedido</h1><p>Simule um registro importado do ERP corporativo.</p></div></div>
        <section class="panel form-panel">
            <% if (suppliers.length === 0) { %>
                <%- include("../partials/empty-state", { heading: "Nenhum fornecedor ativo", description: "Ative ou cadastre um fornecedor antes de criar o pedido.", actionHref: "/suppliers/new", actionLabel: "Cadastrar fornecedor", icon: "◉" }) %>
            <% } else { %>
                <form action="/purchase-orders" method="POST">
                    <div class="form-grid">
                        <div class="form-field"><label for="orderNumber">Número do pedido <span>*</span></label><input id="orderNumber" name="orderNumber" type="text" value="<%= formData.orderNumber || '' %>" placeholder="PC-2026-001" required /></div>
                        <div class="form-field"><label for="supplierId">Fornecedor <span>*</span></label><select id="supplierId" name="supplierId" required><option value="">Selecione</option><% suppliers.forEach((supplier) => { %><option value="<%= supplier._id %>" <%= formData.supplierId === supplier._id.toString() ? 'selected' : '' %>><%= supplier.tradeName %> — <%= formatCnpj(supplier.cnpj) %></option><% }) %></select></div>
                        <div class="form-field"><label for="issueDate">Data de emissão <span>*</span></label><input id="issueDate" name="issueDate" type="date" value="<%= formData.issueDate || '' %>" required /></div>
                        <div class="form-field"><label for="costCenter">Centro de custo <span>*</span></label><input id="costCenter" name="costCenter" type="text" value="<%= formData.costCenter || '' %>" placeholder="Tecnologia" required /></div>
                        <div class="form-field"><label for="totalAmount">Valor total <span>*</span></label><input id="totalAmount" name="totalAmount" type="number" min="0.01" step="0.01" value="<%= formData.totalAmount || '' %>" required /></div>
                        <div class="form-field form-field--wide"><label for="description">Descrição <span>*</span></label><textarea id="description" name="description" rows="4" required><%= formData.description || '' %></textarea></div>
                    </div>
                    <div class="form-actions"><a class="button button--ghost" href="/purchase-orders">Cancelar</a><button class="button button--primary" type="submit">Cadastrar pedido</button></div>
                </form>
            <% } %>
        </section>
        <%- include("../partials/page-end") %>
    </body>
</html>
