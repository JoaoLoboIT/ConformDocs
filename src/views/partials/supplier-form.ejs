<div class="form-grid">
    <div class="form-field form-field--wide">
        <label for="legalName">Razão social <span>*</span></label>
        <input id="legalName" name="legalName" type="text" value="<%= formData.legalName || '' %>" required />
    </div>
    <div class="form-field">
        <label for="tradeName">Nome fantasia <span>*</span></label>
        <input id="tradeName" name="tradeName" type="text" value="<%= formData.tradeName || '' %>" required />
    </div>
    <div class="form-field">
        <label for="cnpj">CNPJ <span>*</span></label>
        <input id="cnpj" name="cnpj" type="text" inputmode="numeric" maxlength="18" value="<%= formData.cnpj || '' %>" data-mask="cnpj" required />
    </div>
    <div class="form-field">
        <label for="email">E-mail <span>*</span></label>
        <input id="email" name="email" type="email" value="<%= formData.email || '' %>" required />
    </div>
    <div class="form-field">
        <label for="phone">Telefone <span>*</span></label>
        <input id="phone" name="phone" type="text" value="<%= formData.phone || '' %>" data-mask="phone" required />
    </div>
    <div class="form-field">
        <label for="contactName">Contato principal</label>
        <input id="contactName" name="contactName" type="text" value="<%= formData.contactName || '' %>" />
    </div>
    <% if (typeof showStatus !== 'undefined' && showStatus) { %>
        <div class="form-field">
            <label for="status">Status</label>
            <select id="status" name="status" required>
                <option value="ACTIVE" <%= formData.status === 'ACTIVE' ? 'selected' : '' %>>Ativo</option>
                <option value="INACTIVE" <%= formData.status === 'INACTIVE' ? 'selected' : '' %>>Inativo</option>
            </select>
        </div>
    <% } %>
</div>
