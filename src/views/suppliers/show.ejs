<!DOCTYPE html>
<html lang="pt-BR">
    <%- include("../partials/head", { title }) %>
    <body>
        <%- include("../partials/page-start", { title }) %>
        <div class="page-heading">
            <div><a class="back-link" href="/suppliers">← Fornecedores</a><span class="eyebrow">PERFIL DO FORNECEDOR</span><h1><%= supplier.tradeName %></h1><p><%= supplier.legalName %></p></div>
            <a class="button button--primary" href="/suppliers/<%= supplier._id %>/edit">Editar fornecedor</a>
        </div>
        <section class="detail-grid">
            <article class="panel detail-card"><span>CNPJ</span><strong><%= formatCnpj(supplier.cnpj) %></strong></article>
            <article class="panel detail-card"><span>Status</span><strong><span class="badge <%= statusClass(supplier.status) %>"><%= statusLabel(supplier.status) %></span></strong></article>
            <article class="panel detail-card"><span>Última atualização</span><strong><%= formatDateTime(supplier.updatedAt) %></strong></article>
        </section>
        <section class="panel">
            <div class="panel__header"><div><span class="eyebrow">CONTATO</span><h2>Dados cadastrais</h2></div></div>
            <dl class="definition-grid">
                <div><dt>E-mail</dt><dd><a href="mailto:<%= supplier.email %>"><%= supplier.email %></a></dd></div>
                <div><dt>Telefone</dt><dd><%= formatPhone(supplier.phone) %></dd></div>
                <div><dt>Contato principal</dt><dd><%= supplier.contactName || 'Não informado' %></dd></div>
                <div><dt>Cadastrado em</dt><dd><%= formatDateTime(supplier.createdAt) %></dd></div>
            </dl>
        </section>
        <%- include("../partials/page-end") %>
    </body>
</html>
