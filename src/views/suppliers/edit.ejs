<!DOCTYPE html>
<html lang="pt-BR">
    <%- include("../partials/head", { title }) %>
    <body>
        <%- include("../partials/page-start", { title }) %>
        <div class="page-heading"><div><a class="back-link" href="/suppliers/<%= formData._id %>">← Voltar ao fornecedor</a><h1>Editar fornecedor</h1><p>Atualize os dados cadastrais e a disponibilidade da empresa.</p></div></div>
        <section class="panel form-panel">
            <form action="/suppliers/<%= formData._id %>/edit" method="POST">
                <%- include("../partials/supplier-form", { formData, showStatus: true }) %>
                <div class="form-actions"><a class="button button--ghost" href="/suppliers/<%= formData._id %>">Cancelar</a><button class="button button--primary" type="submit">Salvar alterações</button></div>
            </form>
        </section>
        <%- include("../partials/page-end") %>
    </body>
</html>
