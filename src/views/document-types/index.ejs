<!DOCTYPE html>
<html lang="pt-BR">
    <%- include("../partials/head", { title }) %>
    <body>
        <%- include("../partials/page-start", { title }) %>
        <div class="page-heading"><div><span class="eyebrow">CONFIGURAÇÃO</span><h1>Tipos de documento</h1><p>Modelos flexíveis com campos, regras e workflows próprios.</p></div><a class="button button--primary" href="/document-types/new">+ Novo tipo</a></div>
        <form class="filter-bar" method="GET" action="/document-types">
            <input name="search" type="search" placeholder="Nome, código ou descrição" value="<%= filters.search %>" />
            <select name="category"><option value="">Todas as categorias</option><option value="FISCAL" <%= filters.category === 'FISCAL' ? 'selected' : '' %>>Fiscal</option><option value="NON_FISCAL" <%= filters.category === 'NON_FISCAL' ? 'selected' : '' %>>Não fiscal</option></select>
            <select name="status"><option value="">Todos os status</option><option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>Ativos</option><option value="INACTIVE" <%= filters.status === 'INACTIVE' ? 'selected' : '' %>>Inativos</option></select>
            <button class="button button--secondary" type="submit">Filtrar</button><a class="button button--text" href="/document-types">Limpar</a>
        </form>
        <section class="cards-grid">
            <% if (documentTypes.length === 0) { %>
                <div class="panel cards-grid__full"><%- include("../partials/empty-state", { heading: "Nenhum tipo encontrado", description: "Crie modelos para notas, contratos e certidões.", actionHref: "/document-types/new", actionLabel: "Cadastrar tipo", icon: "⚙" }) %></div>
            <% } %>
            <% documentTypes.forEach((documentType) => { %>
                <article class="panel type-card">
                    <div class="type-card__top"><span class="type-code"><%= documentType.code %></span><span class="badge <%= statusClass(documentType.status) %>"><%= statusLabel(documentType.status) %></span></div>
                    <h2><%= documentType.name %></h2><p><%= documentType.description %></p>
                    <div class="type-card__tags"><span><%= documentType.category === 'FISCAL' ? 'Fiscal' : 'Não fiscal' %></span><span><%= documentType.customFields?.length || 0 %> campo(s)</span><span><%= documentType.validationRules?.length || 0 %> regra(s)</span></div>
                    <div class="type-card__flags"><span class="<%= documentType.hasExpiration ? 'is-on' : '' %>">Validade</span><span class="<%= documentType.requiresPurchaseOrder ? 'is-on' : '' %>">Pedido de compra</span></div>
                    <a class="button button--ghost button--full" href="/document-types/<%= documentType._id %>/edit">Configurar tipo</a>
                </article>
            <% }) %>
        </section>
        <%- include("../partials/page-end") %>
    </body>
</html>
