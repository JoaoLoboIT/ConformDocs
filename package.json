{
  "name": "conformdocs",
  "version": "1.0.0",
  "description": "Sistema web de gestão, validação, aprovação e controle de documentos de fornecedores com MongoDB.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "node --test",
    "format": "prettier --write \"src/**/*.js\" \"src/public/**/*.css\" \"database/**/*.js\" \"tests/**/*.js\" \"*.json\" \"*.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.js\" \"src/public/**/*.css\" \"database/**/*.js\" \"tests/**/*.js\" \"*.json\" \"*.md\" \"docs/**/*.md\"",
    "db:indexes": "node --env-file=.env database/scripts/create-indexes.js",
    "db:setup": "node --env-file=.env database/scripts/setup-database.js",
    "db:seed": "node --env-file=.env database/seeds/seed.js",
    "db:init": "npm run db:setup && npm run db:seed",
    "db:seed:large": "node --env-file=.env database/seeds/seed-large.js"
  },
  "keywords": [
    "mongodb",
    "nosql",
    "document-management",
    "express",
    "ejs"
  ],
  "author": "João Pedro Ferreira Lobo",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "prettier-plugin-ejs": "^1.0.3"
  }
}
